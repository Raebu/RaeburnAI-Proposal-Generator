{
  "name": "raeburnai-proposal-generator",
  "version": "1.0.0-rc.2",
  "private": false,
  "description": "Enterprise-ready open-source AI proposal and solution generator for consultants.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "docker build -t raeburnai-proposal-generator ."
  },
  "dependencies": {
    "@next/env": "15.5.22",
    "@opennextjs/cloudflare": "1.20.2",
    "clsx": "2.1.1",
    "docx": "9.7.1",
    "next": "15.5.22",
    "openai": "4.52.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.4.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.18.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.22",
    "postcss": "8.5.25",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4",
    "vitest": "4.1.10",
    "wrangler": "4.124.0"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "glob": "10.5.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
