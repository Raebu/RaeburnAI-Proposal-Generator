# Required only when live AI generation is enabled. Leave empty to use the
# clearly-labelled deterministic fallback.
OPENAI_API_KEY=
# Optional
OPENAI_MODEL=gpt-4.1-mini
RATE_LIMIT_REQUESTS_PER_MINUTE=20
# Required in production. Must match PROPOSAL_GENERATOR_API_KEY in AI_Website.
PROPOSAL_API_KEY=
# Set true only when every route is protected by Cloudflare Access and alternate routes are disabled.
TRUST_CLOUDFLARE_ACCESS=false
