NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Workspace/API authentication. Use a secret manager in production.
PROPOSAL_WORKSPACE_ID=development-workspace
PROPOSAL_API_KEY=
TRUST_PROXY_HEADERS=false

# PostgreSQL and Redis
DATABASE_URL=postgresql://proposal:local-development-only@postgres:5432/proposal_generator
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000

# Generation: deterministic | openai
GENERATION_MODE=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# Safety and operations
RATE_LIMIT_REQUESTS_PER_MINUTE=20
LOG_LEVEL=info
HUMAN_APPROVAL_REQUIRED=true
